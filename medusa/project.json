{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "medusa",
  "root": "medusa",
  "sourceRoot": "medusa/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "medusa",
        "command": "yarn build"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "medusa",
        "command": "yarn dev"
      },
      "cache": false,
      "persistent": true
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "medusa",
        "command": "yarn start"
      },
      "cache": false
    },
    "test-unit": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "medusa",
        "command": "yarn test:unit"
      },
      "cache": false
    },
    "test-integration-http": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "medusa",
        "command": "yarn test:integration:http"
      },
      "cache": false
    },
    "test-integration-modules": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "medusa",
        "command": "yarn test:integration:modules"
      },
      "cache": false
    }
  }
}
